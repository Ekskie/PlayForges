{% comment %}
  PlayForge Featured Assets Showcase
  Editorial layout featuring a lead spotlight product and companion catalog cards.
{% endcomment %}

{%- liquid
  assign collection = section.settings.collection
  assign products_to_show = section.settings.products_to_show | default: 7
-%}

<div class="pf-section" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="pf-container">
    <div class="pf-section-header">
      <div class="pf-section-title-wrap">
        <span class="pf-section-kicker">{{ section.settings.kicker | default: 'Curated Catalog' }}</span>
        <h2 class="pf-section-title">{{ section.settings.heading | default: 'Featured Assets' }}</h2>
        <p class="pf-section-subtitle">{{ section.settings.subheading | default: 'Inspected and verified 3D assets ready for deployment into modern real-time game engines.' }}</p>
      </div>

      {%- if section.settings.view_all_link != blank or collection != blank -%}
        <a href="{{ section.settings.view_all_link | default: collection.url | default: routes.all_products_collection_url }}" class="button button--secondary">
          {{ section.settings.view_all_label | default: 'Browse catalog' }}
        </a>
      {%- endif -%}
    </div>

    <div class="pf-editorial-grid">
      {%- if collection != blank and collection.products.size > 0 -%}
        {%- for product in collection.products limit: products_to_show -%}
          {% render 'playforge-card-product',
            card_product: product,
            section_id: section.id,
            show_quick_view: true,
            is_editorial_lead: forloop.first
          %}
        {%- endfor -%}
      {%- elsif collections.all.products.size > 0 -%}
        {%- for product in collections.all.products limit: products_to_show -%}
          {% render 'playforge-card-product',
            card_product: product,
            section_id: section.id,
            show_quick_view: true,
            is_editorial_lead: forloop.first
          %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..6) -%}
          {% render 'playforge-card-product',
            card_product: empty,
            section_id: section.id,
            is_editorial_lead: forloop.first
          %}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Featured Assets",
  "tag": "section",
  "class": "pf-featured-assets-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker Note",
      "default": "Curated Catalog"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Assets"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Inspected and verified 3D assets ready for deployment into modern real-time game engines."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 7,
      "label": "Assets to Show"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View All Action Label",
      "default": "Browse catalog"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Featured Assets"
    }
  ]
}
{% endschema %}
