{% comment %}
  PlayForge — Interactive Modular 3D Bundle Builder
  Allows developers to curate a custom 3-asset production bundle:
  (1) Environment Base Kit, (2) Hero Asset, (3) Prop / Detail Pack
  Features real-time 3D model preview, dynamic 25% bundle savings, and 1-click AJAX add-to-cart.
{% endcomment %}

<div class="pf-bundle-builder page-width section-{{ section.id }}-padding" id="bundle-builder">
  <div class="pf-section-header">
    <div class="pf-section-title-wrap">
      {%- if section.settings.kicker != blank -%}
        <span class="pf-section-kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      <h2 class="pf-section-title">{{ section.settings.heading | escape }}</h2>
    </div>
    {%- if section.settings.subheading != blank -%}
      <p class="pf-section-subtitle">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
  </div>

  <div class="pf-bundle-container" data-pf-bundle-builder>
    <!-- Left / Center: Interactive 3D Stage & Bundle Configurator -->
    <div class="pf-bundle-viewport-card">
      <div class="pf-bundle-stage-header">
        <div class="pf-bundle-active-badge">
          <span class="pf-pulse-dot"></span>
          <span data-bundle-active-title>Sci-Fi Heavy Drone</span>
        </div>
        <div class="pf-spec-pill is-engine" data-bundle-active-engine>UE5 / Unity / Godot</div>
      </div>

      <div class="pf-bundle-model-wrap">
        <model-viewer
          id="pf-bundle-viewer"
          src="{{ 'pf-upload-1791730951473-tindahan-ni-mama.glb' | asset_url }}"
          camera-controls
          auto-rotate
          rotation-per-second="24deg"
          shadow-intensity="1.5"
          exposure="1.0"
          interaction-prompt="none"
          loading="lazy"
          style="width: 100%; height: 380px; background: var(--pf-viewport-bg);"
        >
        </model-viewer>
      </div>

      <div class="pf-bundle-stage-footer">
        <div class="pf-spec-item">
          <span class="pf-spec-label">Combined Topology</span>
          <span class="pf-spec-val" data-bundle-total-poly>~0 Δ Quads</span>
        </div>
        <div class="pf-spec-item">
          <span class="pf-spec-label">Texture Channels</span>
          <span class="pf-spec-val" data-bundle-active-texture>4K PBR (Packed ORM)</span>
        </div>
        <div class="pf-spec-item">
          <span class="pf-spec-label">License Type</span>
          <span class="pf-spec-val" data-bundle-active-license>Commercial Royalty-Free</span>
        </div>
      </div>
    </div>

    <!-- Right: Slot Selector & Dynamic Pricing Summary -->
    <div class="pf-bundle-slots-card">
      <h3 class="pf-bundle-slots-title">Assemble Your Production Kit</h3>
      <p class="pf-bundle-slots-desc">Select 1 asset from each tier to unlock 25% instant bundle discount.</p>

      <!-- Dynamic Bundle Slots Rendered from PlayForge Bundle Kit Builder -->
      {% render 'playforge-bundle-slots' %}


      <!-- Pricing Summary & 1-Click Checkout -->
      <div class="pf-bundle-summary">
        <div class="pf-bundle-calc-row">
          <span class="pf-summary-label">Catalog Price (3 Items):</span>
          <s class="pf-summary-original" data-bundle-original>₱5,400.00</s>
        </div>
        <div class="pf-bundle-calc-row pf-discount-row">
          <span class="pf-summary-label">Bundle Discount (25% OFF):</span>
          <span class="pf-summary-discount" data-bundle-discount>-₱1,350.00</span>
        </div>
        <div class="pf-bundle-total-row">
          <span class="pf-total-label">Total Bundle Price:</span>
          <span class="pf-total-val" data-bundle-final>₱4,050.00</span>
        </div>

        <button type="button" class="pf-bundle-add-btn" data-bundle-add-btn>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
            <line x1="3" y1="6" x2="21" y2="6"/>
            <path d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
          Deploy Custom Bundle to Cart
        </button>
        <div class="pf-bundle-secure-note">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          Instant DCC Downloads (.FBX, .GLB, .OBJ) + Commercial Royalty-Free License
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .pf-bundle-builder {
    margin-top: 48px;
    margin-bottom: 64px;
  }
  .pf-bundle-container {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 32px;
    align-items: stretch;
    margin-top: 28px;
  }
  @media (max-width: 990px) {
    .pf-bundle-container {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
  .pf-bundle-viewport-card, .pf-bundle-slots-card {
    background: var(--pf-bg-surface);
    border: 1px solid var(--pf-border);
    border-radius: var(--pf-radius-lg, 12px);
    padding: 24px;
    box-shadow: var(--pf-shadow-card);
    color: var(--pf-text-primary);
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }
  .pf-bundle-stage-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }
  .pf-bundle-active-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--pf-heading-color);
  }
  .pf-pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--pf-accent, #FF5A1F);
    box-shadow: 0 0 10px var(--pf-accent, #FF5A1F);
  }
  .pf-bundle-model-wrap {
    border-radius: var(--pf-radius-md, 8px);
    overflow: hidden;
    border: 1px solid var(--pf-border);
    background: var(--pf-viewport-bg);
    position: relative;
  }
  .pf-bundle-stage-footer {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--pf-border);
  }
  .pf-spec-label {
    display: block;
    font-size: 1.15rem;
    color: var(--pf-text-secondary);
    margin-bottom: 4px;
    font-family: var(--pf-font-mono, monospace);
  }
  .pf-spec-val {
    display: block;
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--pf-heading-color);
  }
  .pf-bundle-slots-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--pf-heading-color);
    margin: 0 0 6px 0;
    letter-spacing: -0.02em;
  }
  .pf-bundle-slots-desc {
    color: var(--pf-text-secondary);
    font-size: 1.3rem;
    margin: 0 0 20px 0;
    line-height: 1.4;
  }
  .pf-bundle-slot {
    margin-bottom: 16px;
  }
  .pf-slot-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }
  .pf-slot-step {
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    background: var(--pf-accent-subtle, rgba(255, 90, 31, 0.12));
    color: var(--pf-accent, #FF5A1F);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: var(--pf-font-mono, monospace);
  }
  .pf-slot-name {
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--pf-heading-color);
  }
  .pf-slot-options {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .pf-slot-btn {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 10px 12px;
    background: var(--pf-bg-surface-subtle);
    border: 1px solid var(--pf-border);
    border-radius: var(--pf-radius-sm, 6px);
    cursor: pointer;
    text-align: left;
    transition: var(--pf-transition);
  }
  .pf-slot-btn:hover {
    border-color: var(--pf-accent);
    background: var(--pf-bg-surface);
    transform: translateY(-1px);
  }
  .pf-slot-btn.is-active {
    border-color: var(--pf-accent);
    background: var(--pf-accent-subtle);
    box-shadow: 0 0 0 1px var(--pf-accent);
  }
  .pf-slot-btn-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--pf-heading-color);
    line-height: 1.2;
    margin-bottom: 4px;
  }
  .pf-slot-btn.is-active .pf-slot-btn-title {
    color: var(--pf-heading-color);
    font-weight: 700;
  }
  .pf-slot-btn-price {
    font-size: 1.2rem;
    color: var(--pf-accent);
    font-weight: 700;
    font-family: var(--pf-font-mono, monospace);
  }
  .pf-bundle-summary {
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--pf-border);
  }
  .pf-bundle-calc-row {
    display: flex;
    justify-content: space-between;
    font-size: 1.3rem;
    color: var(--pf-text-secondary);
    margin-bottom: 6px;
  }
  .pf-discount-row {
    color: #10B981 !important;
    font-weight: 600;
  }
  .pf-bundle-total-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin: 12px 0 16px 0;
    padding: 10px 0;
    border-top: 1px dashed var(--pf-border);
  }
  .pf-total-label {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--pf-heading-color);
  }
  .pf-total-val {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--pf-accent);
    font-family: var(--pf-font-mono, monospace);
  }
  .pf-bundle-add-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 20px;
    background: var(--pf-accent, #FF5A1F);
    color: #ffffff;
    font-size: 1.4rem;
    font-weight: 700;
    border: none;
    border-radius: var(--pf-radius-sm, 6px);
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(255, 90, 31, 0.35);
    transition: var(--pf-transition);
  }
  .pf-bundle-add-btn:hover {
    background: var(--pf-accent-hover, #e04b14);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(255, 90, 31, 0.5);
  }
  .pf-bundle-secure-note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 1.15rem;
    color: var(--pf-text-tertiary);
    margin-top: 12px;
    text-align: center;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const builder = document.querySelector('[data-pf-bundle-builder]');
    if (!builder) return;

    const viewer = builder.querySelector('#pf-bundle-viewer');
    const titleBadge = builder.querySelector('[data-bundle-active-title]');
    const engineBadge = builder.querySelector('[data-bundle-active-engine]');
    const textureBadge = builder.querySelector('[data-bundle-active-texture]');
    const licenseBadge = builder.querySelector('[data-bundle-active-license]');
    const totalPolyBadge = builder.querySelector('[data-bundle-total-poly]');
    const originalPriceEl = builder.querySelector('[data-bundle-original]');
    const discountPriceEl = builder.querySelector('[data-bundle-discount]');
    const finalPriceEl = builder.querySelector('[data-bundle-final]');
    const addBtn = builder.querySelector('[data-bundle-add-btn]');
    const discountGroup = builder.querySelector('[data-bundle-discount-rate]');

    const discountRate = discountGroup
      ? (parseFloat(discountGroup.dataset.bundleDiscountRate || 25) / 100)
      : 0.25;

    function applyOptionToViewer(btn) {
      if (!btn) return;
      if (btn.dataset.model && viewer) {
        viewer.src = btn.dataset.model;
      }
      if (titleBadge && btn.dataset.name) {
        titleBadge.textContent = btn.dataset.name;
      }
      if (engineBadge && btn.dataset.engine) {
        engineBadge.textContent = btn.dataset.engine;
      }
      if (textureBadge && btn.dataset.texture) {
        textureBadge.textContent = btn.dataset.texture;
      }
      if (licenseBadge && btn.dataset.license) {
        licenseBadge.textContent = btn.dataset.license;
      }
    }

    function updateBundleCalculations() {
      const activeBtns = builder.querySelectorAll('.pf-slot-btn.is-active');
      let subtotal = 0;
      let totalPoly = 0;

      activeBtns.forEach(btn => {
        subtotal += parseFloat(btn.dataset.price || 0);
        totalPoly += parseInt(btn.dataset.poly || 0, 10);
      });

      const discount = subtotal * discountRate;
      const finalPrice = subtotal - discount;
      const discountPct = Math.round(discountRate * 100);

      if (originalPriceEl) originalPriceEl.textContent = '₱' + subtotal.toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (discountPriceEl) discountPriceEl.textContent = '-₱' + discount.toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const discountRowLabel = builder.querySelector('.pf-discount-row .pf-summary-label');
      if (discountRowLabel) discountRowLabel.textContent = `Bundle Discount (${discountPct}% OFF):`;
      if (finalPriceEl) finalPriceEl.textContent = '₱' + finalPrice.toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (totalPolyBadge) totalPolyBadge.textContent = '~' + totalPoly.toLocaleString() + ' Δ Quads';
    }

    // Initialize viewer from the first active slot button
    const firstActive = builder.querySelector('.pf-slot-btn.is-active') || builder.querySelector('.pf-slot-btn');
    if (firstActive) {
      applyOptionToViewer(firstActive);
    }

    // Attach click listeners to all slot options
    builder.querySelectorAll('.pf-slot-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        const parentSlot = this.closest('.pf-bundle-slot');
        if (parentSlot) {
          parentSlot.querySelectorAll('.pf-slot-btn').forEach(b => b.classList.remove('is-active'));
          this.classList.add('is-active');
        }

        applyOptionToViewer(this);
        updateBundleCalculations();
      });
    });

    if (addBtn) {
      addBtn.addEventListener('click', function() {
        addBtn.disabled = true;
        const originalText = addBtn.innerHTML;
        addBtn.innerHTML = '<span>Packaging 3D Assets...</span>';

        const activeBtns = builder.querySelectorAll('.pf-slot-btn.is-active');
        const items = [];

        activeBtns.forEach(btn => {
          const vid = btn.dataset.variantId;
          if (vid && parseInt(vid, 10)) {
            items.push({
              id: parseInt(vid, 10),
              quantity: 1,
              properties: {
                'Custom Bundle': 'PlayForge 3D Production Kit',
                'Asset': btn.dataset.name || '3D Asset',
                'Discount': Math.round(discountRate * 100) + '% Instant Savings',
                'Licensing': btn.dataset.license || 'Commercial Royalty-Free'
              }
            });
          }
        });

        // Fallback to first store product if variants are not yet assigned
        if (items.length === 0) {
          items.push({
            id: {{ collections.all.products.first.variants.first.id | default: 1 }},
            quantity: 1,
            properties: {
              'Custom Bundle': 'PlayForge 3D Production Kit',
              'Discount': Math.round(discountRate * 100) + '% Instant Savings',
              'Licensing': 'Commercial Royalty-Free'
            }
          });
        }

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items })
        })
        .then(res => res.json())
        .then(() => {
          addBtn.innerHTML = '✓ Bundle Added to Cart!';
          addBtn.style.background = '#22c55e';
          const drawer = document.querySelector('cart-drawer');
          if (drawer && typeof drawer.open === 'function') {
            drawer.open();
          } else {
            window.location.href = '/cart';
          }
          setTimeout(() => {
            addBtn.innerHTML = originalText;
            addBtn.style.background = '';
            addBtn.disabled = false;
          }, 2500);
        })
        .catch(() => {
          window.location.href = '/cart';
        });
      });
    }

    updateBundleCalculations();
  });
</script>

{% schema %}
{
  "name": "3D Bundle Builder",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Interactive Custom Kit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Modular 3D Environment Bundle Builder"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Assemble complete scene kits with real-time 3D inspection and save 25% on combined licensing."
    }
  ],
  "presets": [
    {
      "name": "3D Bundle Builder"
    }
  ]
}
{% endschema %}
