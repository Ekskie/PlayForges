{% comment %}
  PlayForge — Interactive Modular 3D Bundle Builder
  Allows developers to curate a custom 3-asset production bundle:
  (1) Environment Base Kit, (2) Hero Asset, (3) Prop / Detail Pack
  Features real-time 3D model preview, dynamic 25% bundle savings, and 1-click AJAX add-to-cart.
{% endcomment %}

<div class="pf-bundle-builder page-width section-{{ section.id }}-padding" id="bundle-builder">
  <div class="pf-section-header">
    {%- if section.settings.kicker != blank -%}
      <span class="pf-kicker">{{ section.settings.kicker }}</span>
    {%- endif -%}
    <h2 class="pf-section-title">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.subheading != blank -%}
      <p class="pf-section-sub">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
  </div>

  <div class="pf-bundle-container" data-pf-bundle-builder>
    <!-- Left / Center: Interactive 3D Stage & Bundle Configurator -->
    <div class="pf-bundle-viewport-card">
      <div class="pf-bundle-stage-header">
        <div class="pf-bundle-active-badge">
          <span class="pf-pulse-dot"></span>
          <span data-bundle-active-title>Sci-Fi Heavy Drone</span>
        </div>
        <div class="pf-spec-pill is-engine" data-bundle-active-engine>UE5 / Unity / Godot</div>
      </div>

      <div class="pf-bundle-model-wrap">
        <model-viewer
          id="pf-bundle-viewer"
          src="{{ 'pf-model-drone.glb' | asset_url }}"
          camera-controls
          auto-rotate
          rotation-per-second="24deg"
          shadow-intensity="1.5"
          exposure="1.0"
          interaction-prompt="none"
          loading="lazy"
          style="width: 100%; height: 380px; background: radial-gradient(circle at 50% 50%, #1c1d25 0%, #0d0e12 100%);"
        >
        </model-viewer>
      </div>

      <div class="pf-bundle-stage-footer">
        <div class="pf-spec-item">
          <span class="pf-spec-label">Combined Topology</span>
          <span class="pf-spec-val" data-bundle-total-poly>~42,800 Δ Quads</span>
        </div>
        <div class="pf-spec-item">
          <span class="pf-spec-label">Texture Channels</span>
          <span class="pf-spec-val">4K PBR (Packed ORM)</span>
        </div>
        <div class="pf-spec-item">
          <span class="pf-spec-label">License Type</span>
          <span class="pf-spec-val">Commercial Royalty-Free</span>
        </div>
      </div>
    </div>

    <!-- Right: Slot Selector & Dynamic Pricing Summary -->
    <div class="pf-bundle-slots-card">
      <h3 class="pf-bundle-slots-title">Assemble Your Production Kit</h3>
      <p class="pf-bundle-slots-desc">Select 1 asset from each tier to unlock 25% instant bundle discount.</p>

      <!-- Slot 1: Base Environment -->
      <div class="pf-bundle-slot" data-slot="environment">
        <div class="pf-slot-header">
          <span class="pf-slot-step">Step 1</span>
          <span class="pf-slot-name">Environment Kit</span>
        </div>
        <div class="pf-slot-options">
          <button type="button" class="pf-slot-btn is-active" data-name="Orbital Colony Outpost" data-price="2400" data-poly="28400" data-model="{{ 'pf-model-astronaut.glb' | asset_url }}">
            <span class="pf-slot-btn-title">Orbital Colony Outpost</span>
            <span class="pf-slot-btn-price">₱2,400.00</span>
          </button>
          <button type="button" class="pf-slot-btn" data-name="Subterranean Bunker" data-price="2100" data-poly="24100" data-model="{{ 'pf-model-helmet.glb' | asset_url }}">
            <span class="pf-slot-btn-title">Subterranean Bunker</span>
            <span class="pf-slot-btn-price">₱2,100.00</span>
          </button>
        </div>
      </div>

      <!-- Slot 2: Hero Asset -->
      <div class="pf-bundle-slot" data-slot="hero">
        <div class="pf-slot-header">
          <span class="pf-slot-step">Step 2</span>
          <span class="pf-slot-name">Hero Character / Mech</span>
        </div>
        <div class="pf-slot-options">
          <button type="button" class="pf-slot-btn is-active" data-name="Autonomous Recon Drone" data-price="1750" data-poly="14400" data-model="{{ 'pf-model-drone.glb' | asset_url }}">
            <span class="pf-slot-btn-title">Autonomous Recon Drone</span>
            <span class="pf-slot-btn-price">₱1,750.00</span>
          </button>
          <button type="button" class="pf-slot-btn" data-name="Heavy Combat Operative" data-price="1950" data-poly="18200" data-model="{{ 'pf-model-astronaut.glb' | asset_url }}">
            <span class="pf-slot-btn-title">Heavy Combat Operative</span>
            <span class="pf-slot-btn-price">₱1,950.00</span>
          </button>
        </div>
      </div>

      <!-- Slot 3: Modular Props Pack -->
      <div class="pf-bundle-slot" data-slot="props">
        <div class="pf-slot-header">
          <span class="pf-slot-step">Step 3</span>
          <span class="pf-slot-name">Modular Prop Pack</span>
        </div>
        <div class="pf-slot-options">
          <button type="button" class="pf-slot-btn is-active" data-name="Tactical Terminal & Hologram Set" data-price="1250" data-poly="8200" data-model="{{ 'pf-model-helmet.glb' | asset_url }}">
            <span class="pf-slot-btn-title">Tactical Terminal Set</span>
            <span class="pf-slot-btn-price">₱1,250.00</span>
          </button>
          <button type="button" class="pf-slot-btn" data-name="Industrial Storage & Crate Kit" data-price="1100" data-poly="6800" data-model="{{ 'pf-model-drone.glb' | asset_url }}">
            <span class="pf-slot-btn-title">Industrial Crate Kit</span>
            <span class="pf-slot-btn-price">₱1,100.00</span>
          </button>
        </div>
      </div>

      <!-- Pricing Summary & 1-Click Checkout -->
      <div class="pf-bundle-summary">
        <div class="pf-bundle-calc-row">
          <span class="pf-summary-label">Catalog Price (3 Items):</span>
          <s class="pf-summary-original" data-bundle-original>₱5,400.00</s>
        </div>
        <div class="pf-bundle-calc-row pf-discount-row">
          <span class="pf-summary-label">Bundle Discount (25% OFF):</span>
          <span class="pf-summary-discount" data-bundle-discount>-₱1,350.00</span>
        </div>
        <div class="pf-bundle-total-row">
          <span class="pf-total-label">Total Bundle Price:</span>
          <span class="pf-total-val" data-bundle-final>₱4,050.00</span>
        </div>

        <button type="button" class="pf-bundle-add-btn" data-bundle-add-btn>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
            <line x1="3" y1="6" x2="21" y2="6"/>
            <path d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
          Deploy Custom Bundle to Cart
        </button>
        <div class="pf-bundle-secure-note">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          Instant DCC Downloads (.FBX, .GLB, .OBJ) + Commercial Royalty-Free License
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .pf-bundle-builder {
    margin-top: 48px;
    margin-bottom: 64px;
  }
  .pf-bundle-container {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 32px;
    align-items: stretch;
    margin-top: 28px;
  }
  @media (max-width: 990px) {
    .pf-bundle-container {
      grid-template-columns: 1fr;
    }
  }
  .pf-bundle-viewport-card, .pf-bundle-slots-card {
    background: #121318 !important;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    border-radius: var(--pf-radius-lg, 12px);
    padding: 24px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
    color: #f1efe7 !important;
  }
  .pf-bundle-stage-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }
  .pf-bundle-active-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1.4rem;
    font-weight: 700;
    color: #ffffff !important;
  }
  .pf-pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--pf-forge-orange, #FF5A1F);
    box-shadow: 0 0 10px var(--pf-forge-orange, #FF5A1F);
  }
  .pf-bundle-model-wrap {
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    position: relative;
  }
  .pf-bundle-stage-footer {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .pf-spec-label {
    display: block;
    font-size: 1.15rem;
    color: #94a3b8 !important;
    margin-bottom: 4px;
    font-family: var(--pf-font-mono, monospace);
  }
  .pf-spec-val {
    display: block;
    font-size: 1.3rem;
    font-weight: 600;
    color: #ffffff !important;
  }
  .pf-bundle-slots-title {
    font-size: 2rem;
    font-weight: 700;
    color: #ffffff !important;
    margin: 0 0 6px 0;
  }
  .pf-bundle-slots-desc {
    color: #94a3b8 !important;
    font-size: 1.3rem;
    margin: 0 0 20px 0;
  }
  .pf-bundle-slot {
    margin-bottom: 16px;
  }
  .pf-slot-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }
  .pf-slot-step {
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    background: rgba(255, 90, 31, 0.18);
    color: #FF5A1F !important;
    padding: 2px 6px;
    border-radius: 4px;
  }
  .pf-slot-name {
    font-size: 1.35rem;
    font-weight: 600;
    color: #ffffff !important;
  }
  .pf-slot-options {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .pf-slot-btn {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 10px 12px;
    background: #181920 !important;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    border-radius: 6px;
    cursor: pointer;
    text-align: left;
    transition: all 0.2s ease;
  }
  .pf-slot-btn:hover {
    border-color: rgba(255, 90, 31, 0.5) !important;
    background: #20222b !important;
  }
  .pf-slot-btn.is-active {
    border-color: #FF5A1F !important;
    background: rgba(255, 90, 31, 0.14) !important;
    box-shadow: 0 0 12px rgba(255, 90, 31, 0.25) !important;
  }
  .pf-slot-btn-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: #ffffff !important;
    line-height: 1.2;
    margin-bottom: 4px;
  }
  .pf-slot-btn.is-active .pf-slot-btn-title {
    color: #ffffff !important;
    font-weight: 700;
  }
  .pf-slot-btn-price {
    font-size: 1.2rem;
    color: #FF5A1F !important;
    font-weight: 700;
  }
  .pf-bundle-summary {
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .pf-bundle-calc-row {
    display: flex;
    justify-content: space-between;
    font-size: 1.3rem;
    color: #94a3b8 !important;
    margin-bottom: 6px;
  }
  .pf-discount-row {
    color: #22c55e !important;
    font-weight: 600;
  }
  .pf-bundle-total-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin: 12px 0 16px 0;
    padding: 10px 0;
    border-top: 1px dashed rgba(255, 255, 255, 0.15);
  }
  .pf-total-label {
    font-size: 1.5rem;
    font-weight: 700;
    color: #ffffff !important;
  }
  .pf-total-val {
    font-size: 2.2rem;
    font-weight: 800;
    color: #FF5A1F !important;
  }
  .pf-bundle-add-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 20px;
    background: var(--pf-forge-orange, #FF5A1F);
    color: #ffffff;
    font-size: 1.4rem;
    font-weight: 700;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(255, 90, 31, 0.4);
    transition: all 0.2s ease;
  }
  .pf-bundle-add-btn:hover {
    background: #e04b14;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(255, 90, 31, 0.6);
  }
  .pf-bundle-secure-note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 1.15rem;
    color: var(--pf-text-muted, #64748b);
    margin-top: 12px;
    text-align: center;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const builder = document.querySelector('[data-pf-bundle-builder]');
    if (!builder) return;

    const viewer = builder.querySelector('#pf-bundle-viewer');
    const titleBadge = builder.querySelector('[data-bundle-active-title]');
    const totalPolyBadge = builder.querySelector('[data-bundle-total-poly]');
    const originalPriceEl = builder.querySelector('[data-bundle-original]');
    const discountPriceEl = builder.querySelector('[data-bundle-discount]');
    const finalPriceEl = builder.querySelector('[data-bundle-final]');
    const addBtn = builder.querySelector('[data-bundle-add-btn]');

    function updateBundleCalculations() {
      const activeBtns = builder.querySelectorAll('.pf-slot-btn.is-active');
      let subtotal = 0;
      let totalPoly = 0;

      activeBtns.forEach(btn => {
        subtotal += parseFloat(btn.dataset.price || 0);
        totalPoly += parseInt(btn.dataset.poly || 0, 10);
      });

      const discount = subtotal * 0.25;
      const finalPrice = subtotal - discount;

      if (originalPriceEl) originalPriceEl.textContent = '₱' + subtotal.toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (discountPriceEl) discountPriceEl.textContent = '-₱' + discount.toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (finalPriceEl) finalPriceEl.textContent = '₱' + finalPrice.toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (totalPolyBadge) totalPolyBadge.textContent = '~' + totalPoly.toLocaleString() + ' Δ Quads';
    }

    builder.querySelectorAll('.pf-slot-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        const parentSlot = this.closest('.pf-bundle-slot');
        if (parentSlot) {
          parentSlot.querySelectorAll('.pf-slot-btn').forEach(b => b.classList.remove('is-active'));
          this.classList.add('is-active');
        }

        // Update 3D viewer model if provided
        if (this.dataset.model && viewer) {
          viewer.src = this.dataset.model;
        }
        if (titleBadge && this.dataset.name) {
          titleBadge.textContent = this.dataset.name;
        }

        updateBundleCalculations();
      });
    });

    if (addBtn) {
      addBtn.addEventListener('click', function() {
        addBtn.disabled = true;
        const originalText = addBtn.innerHTML;
        addBtn.innerHTML = '<span>Packaging 3D Assets...</span>';

        // Add to Shopify cart drawer using AJAX Cart API
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            items: [
              {
                id: {{ collections.all.products.first.variants.first.id | default: 1 }},
                quantity: 1,
                properties: {
                  'Custom Bundle': '3D Production Pack',
                  'Bundle Discount': '25% Instant Savings',
                  'Licensing': 'Commercial Royalty-Free'
                }
              }
            ]
          })
        })
        .then(res => res.json())
        .then(() => {
          addBtn.innerHTML = '✓ Bundle Added to Cart!';
          addBtn.style.background = '#22c55e';
          // Open cart drawer if available
          const drawer = document.querySelector('cart-drawer');
          if (drawer && typeof drawer.open === 'function') {
            drawer.open();
          } else {
            window.location.href = '/cart';
          }
          setTimeout(() => {
            addBtn.innerHTML = originalText;
            addBtn.style.background = '';
            addBtn.disabled = false;
          }, 2500);
        })
        .catch(() => {
          // Fallback redirect to cart
          window.location.href = '/cart';
        });
      });
    }

    updateBundleCalculations();
  });
</script>

{% schema %}
{
  "name": "3D Bundle Builder",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Interactive Custom Kit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Modular 3D Environment Bundle Builder"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Assemble complete scene kits with real-time 3D inspection and save 25% on combined licensing."
    }
  ],
  "presets": [
    {
      "name": "3D Bundle Builder"
    }
  ]
}
{% endschema %}
