{% comment %}
  PlayForge Studio Standard Section
  5 technical pillars distinguishing PlayForge assets from generic asset stores.
{% endcomment %}

<div
  class="pf-section"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; border-top: 1px solid var(--pf-border-subtle);"
>
  <div class="pf-container">
    <div class="pf-section-header">
      <div class="pf-section-title-wrap">
        <span class="pf-section-kicker">{{ section.settings.kicker | default: 'Studio Standard' }}</span>
        <h2 class="pf-section-title">{{ section.settings.heading | default: 'Engine-Ready Architecture' }}</h2>
        <p class="pf-section-subtitle">
          {{
            section.settings.subheading
            | default: 'Every asset in our catalog undergoes rigorous technical validation to ensure seamless drag-and-drop integration into modern game pipelines.'
          }}
        </p>
      </div>
    </div>

    <div class="pf-standards-list">
      {%- for block in section.blocks -%}
        <div class="pf-standard-item" {{ block.shopify_attributes }}>
          <span class="pf-standard-num">0{{ forloop.index }}</span>
          <div class="pf-standard-content">
            <h3 class="pf-standard-title">{{ block.settings.title }}</h3>
            <p class="pf-standard-desc">{{ block.settings.description }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Why PlayForge",
  "tag": "section",
  "class": "pf-why-playforge-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker Note",
      "default": "Studio Standard"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Engine-Ready Architecture"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Every asset in our catalog undergoes rigorous technical validation to ensure seamless drag-and-drop integration into modern game pipelines."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pipeline Pillar",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Pillar Title",
          "default": "Game-Ready Topology"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Clean quads and tris with intentional edge loops, zero non-manifold vertices, optimized silhouette density, and full LOD0 to LOD3 hierarchies."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why PlayForge",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "title": "Clean Quad Topology",
            "description": "Consistent edge flow, zero non-manifold geometry, verified normal orientation, and full LOD hierarchies."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "title": "Calibrated PBR Materials",
            "description": "Physically accurate metallic, roughness, and normal maps packed natively for Unreal ORM and Unity Mask maps."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "title": "Multi-Format Exports",
            "description": "FBX, GLB/glTF, OBJ, and native source files with clean pivots centered at root for immediate level design placement."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "title": "Clear Commercial Licensing",
            "description": "Straightforward royalty-free commercial licenses covering unlimited shipped games, interactive apps, and cinematic productions."
          }
        }
      ]
    }
  ]
}
{% endschema %}
