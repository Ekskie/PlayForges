{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="pf-contact-section section-{{ section.id }}-padding">
  <div class="pf-contact-wrap">
    <!-- Header -->
    <div class="pf-contact-header">
      <div class="pf-contact-kicker">
        <span class="pf-contact-pulse"></span>
        {{ section.settings.kicker | default: 'Studio Transmission & Pipeline Support' }}
      </div>
      <h1 class="pf-contact-title">
        {{ section.settings.heading | default: "Let's Build Something Exceptional." }}
      </h1>
      <p class="pf-contact-subtitle">
        {{ section.settings.subheading | default: 'Have a custom asset commission, technical integration question (UE5 / Unity / Godot), or studio licensing inquiry? Reach our 3D engineering artists directly.' }}
      </p>
    </div>

    <!-- 2-Column Studio Split Layout -->
    <div class="pf-contact-split">
      <!-- Left Column: Studio Channels & Technical Guarantees -->
      <div class="pf-contact-info-col">
        <!-- Direct Channels Card -->
        <div class="pf-contact-card">
          <h3 class="pf-card-heading">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--pf-accent, #ff5a1f);">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            Direct Studio Inquiries
          </h3>

          <div class="pf-channel-list">
            <div class="pf-channel-item">
              <div class="pf-channel-icon-wrap">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              </div>
              <div class="pf-channel-content">
                <span class="pf-channel-label">Technical Studio Email</span>
                <a href="mailto:{{ section.settings.email | default: 'studio@playforges.com' }}" class="pf-channel-val">
                  {{ section.settings.email | default: 'studio@playforges.com' }}
                </a>
              </div>
            </div>

            <div class="pf-channel-item">
              <div class="pf-channel-icon-wrap">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
              </div>
              <div class="pf-channel-content">
                <span class="pf-channel-label">Response Commitment</span>
                <span class="pf-channel-val">{{ section.settings.response_time | default: 'Under 24 hours (Mon–Fri)' }}</span>
              </div>
            </div>

            <div class="pf-channel-item">
              <div class="pf-channel-icon-wrap">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="2" y1="12" x2="22" y2="12"></line>
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                </svg>
              </div>
              <div class="pf-channel-content">
                <span class="pf-channel-label">Studio Operating Region</span>
                <span class="pf-channel-val">GMT+8 (Philippines / APAC Hub)</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Technical Standards Card -->
        <div class="pf-contact-card">
          <h3 class="pf-card-heading">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--pf-accent, #ff5a1f);">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
            </svg>
            PlayForge Production Standards
          </h3>

          <div class="pf-channel-list">
            <div class="pf-channel-item">
              <div class="pf-channel-icon-wrap">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                  <polyline points="2 17 12 22 22 17"></polyline>
                  <polyline points="2 12 12 17 22 12"></polyline>
                </svg>
              </div>
              <div class="pf-channel-content">
                <span class="pf-channel-val" style="font-size: 1.3rem;">Clean Quad Topology</span>
                <span class="pf-channel-label" style="text-transform: none; font-size: 1.2rem;">LOD0–LOD3 hierarchies, zero non-manifold faces, clean UV lightmaps.</span>
              </div>
            </div>

            <div class="pf-channel-item">
              <div class="pf-channel-icon-wrap">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="3"></circle>
                  <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                </svg>
              </div>
              <div class="pf-channel-content">
                <span class="pf-channel-val" style="font-size: 1.3rem;">Target Engine Pipeline Matrix</span>
                <div class="pf-engine-tags">
                  <span class="pf-engine-tag"><span></span>Unreal Engine 5</span>
                  <span class="pf-engine-tag"><span></span>Unity 2022+</span>
                  <span class="pf-engine-tag"><span></span>Godot 4</span>
                  <span class="pf-engine-tag"><span></span>Blender 4.x</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Studio Transmission Console -->
      <div class="pf-contact-form-card">
        <div class="pf-form-card-top">
          <h2 class="pf-form-title">Direct Studio Message</h2>
        </div>

        {%- form 'contact', id: 'ContactForm', class: 'pf-contact-form-inner' -%}
          {%- if form.posted_successfully? -%}
            <div class="pf-form-alert pf-form-alert--success" role="status" tabindex="-1" autofocus>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
              <div>
                <strong>Transmission Received.</strong><br>
                Thank you! Our technical art team has received your message and will review your pipeline specifications shortly.
              </div>
            </div>
          {%- elsif form.errors -%}
            <div class="pf-form-alert pf-form-alert--error" role="alert" tabindex="-1" autofocus>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
              <div>
                <strong>Please check your submission:</strong><br>
                {{ form.errors | default_errors }}
              </div>
            </div>
          {%- endif -%}

          <!-- Inquiry Category Selector -->
          <div class="pf-inquiry-chips-wrap">
            <label class="pf-inquiry-label">Select Inquiry Category</label>
            <input type="hidden" name="contact[Inquiry Category]" id="pf-inquiry-category" value="Engine Integration">
            <div class="pf-inquiry-chips" role="radiogroup">
              <button type="button" class="pf-chip-btn is-active" data-cat="Engine Integration">Engine Integration</button>
              <button type="button" class="pf-chip-btn" data-cat="Custom 3D Commission">Custom Commission</button>
              <button type="button" class="pf-chip-btn" data-cat="Commercial Licensing">Commercial Licensing</button>
              <button type="button" class="pf-chip-btn" data-cat="Technical Asset Support">Asset Support</button>
            </div>
          </div>

          <!-- Name & Email Row -->
          <div class="pf-form-grid-2">
            <div class="pf-field-group">
              <label for="ContactForm-name">Your Name *</label>
              <input
                type="text"
                id="ContactForm-name"
                name="contact[name]"
                class="pf-input"
                required
                autocomplete="name"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                placeholder="e.g. Alex Rivera"
              >
            </div>

            <div class="pf-field-group">
              <label for="ContactForm-email">Studio / Developer Email *</label>
              <input
                type="email"
                id="ContactForm-email"
                name="contact[email]"
                class="pf-input"
                required
                autocomplete="email"
                spellcheck="false"
                autocapitalize="off"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                placeholder="alex@studio.com"
              >
            </div>
          </div>

          <!-- Phone / Discord Row -->
          <div class="pf-field-group">
            <label for="ContactForm-phone">Phone or Discord Handle (Optional)</label>
            <input
              type="text"
              id="ContactForm-phone"
              name="contact[phone_or_discord]"
              class="pf-input"
              value="{% if form.phone %}{{ form.phone }}{% endif %}"
              placeholder="e.g. +63 912 345 6789 or @alex_3d"
            >
          </div>

          <!-- Message Textarea -->
          <div class="pf-field-group">
            <label for="ContactForm-body">Project Details or Technical Query *</label>
            <textarea
              id="ContactForm-body"
              name="contact[body]"
              class="pf-textarea"
              rows="6"
              required
              placeholder="Describe your engine target, target polygon budget, LOD requirements, or questions..."
            >{{ form.body }}</textarea>
          </div>

          <!-- Submit Button -->
          <button type="submit" class="pf-contact-submit-btn">
            Transmit Message to Studio
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="22" y1="2" x2="11" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
          </button>

          <!-- Trust & Encryption Note -->
          <div class="pf-form-trust-note">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--pf-accent, #ff5a1f);">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            256-bit encrypted studio transmission. Your project data is never shared.
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    function initPfContactChips() {
      var chips = document.querySelectorAll('.pf-chip-btn');
      var catInput = document.getElementById('pf-inquiry-category');
      if (!chips.length) return;
      chips.forEach(function(chip) {
        chip.addEventListener('click', function(e) {
          e.preventDefault();
          chips.forEach(function(c) { c.classList.remove('is-active'); });
          chip.classList.add('is-active');
          if (catInput) {
            catInput.value = chip.getAttribute('data-cat') || 'General Inquiry';
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPfContactChips);
    } else {
      initPfContactChips();
    }
    document.addEventListener('shopify:section:load', initPfContactChips);
  })();
</script>

{% schema %}
{
  "name": "Studio Contact",
  "tag": "section",
  "class": "pf-contact-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker Note",
      "default": "Studio Transmission & Pipeline Support"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Let's Build Something Exceptional."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Have a custom asset commission, technical integration question (UE5 / Unity / Godot), or studio licensing inquiry? Reach our 3D engineering artists directly."
    },
    {
      "type": "text",
      "id": "email",
      "label": "Studio Support Email",
      "default": "studio@playforges.com"
    },
    {
      "type": "text",
      "id": "response_time",
      "label": "Response Time Note",
      "default": "Under 24 hours (Mon–Fri)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Studio Contact"
    }
  ]
}
{% endschema %}
