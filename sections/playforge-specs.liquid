{% comment %}
  PlayForge Asset Compatibility / Technical Specs Section
  Highlights engine support matrix, UV standards, and format specifications.
{% endcomment %}

<div class="pf-section" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; border-top: 1px solid var(--pf-border-subtle);">
  <div class="pf-container">
    <div class="pf-section-header">
      <div class="pf-section-title-wrap">
        <span class="pf-section-kicker">{{ section.settings.kicker | default: 'Universal Integration' }}</span>
        <h2 class="pf-section-title">{{ section.settings.heading | default: 'Compatibility & Pipeline Matrix' }}</h2>
        <p class="pf-section-subtitle">{{ section.settings.subheading | default: 'Standardized specifications verified across industry standard game engines and digital content creation tools.' }}</p>
      </div>
    </div>

    <div class="pf-specs-list">
      <div class="pf-spec-row-item">
        <span class="pf-spec-row-key">Primary Game Engines</span>
        <span class="pf-spec-row-val">Unreal Engine 5.0+, Unity 2022+ (URP/HDRP), Godot 4.0+</span>
      </div>

      <div class="pf-spec-row-item">
        <span class="pf-spec-row-key">3D DCC Packages</span>
        <span class="pf-spec-row-val">Blender 3.6+, Maya, 3ds Max, Cinema 4D, Houdini</span>
      </div>

      <div class="pf-spec-row-item">
        <span class="pf-spec-row-key">Texture Workflow</span>
        <span class="pf-spec-row-val">Metallic / Roughness PBR, 8-bit &amp; 16-bit Normal Maps</span>
      </div>

      <div class="pf-spec-row-item">
        <span class="pf-spec-row-key">UV Coordinates</span>
        <span class="pf-spec-row-val">Non-Overlapping Lightmap Channel 2, Zero Stretched UVs</span>
      </div>

      <div class="pf-spec-row-item">
        <span class="pf-spec-row-key">Real-Time Web 3D</span>
        <span class="pf-spec-row-val">GLB/glTF 2.0 with Draco / Meshopt Compression</span>
      </div>

      <div class="pf-spec-row-item">
        <span class="pf-spec-row-key">Collision &amp; Units</span>
        <span class="pf-spec-row-val">Metric Units (1m / 1cm), Simplified Convex Colliders Included</span>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Pipeline Compatibility",
  "tag": "section",
  "class": "pf-specs-matrix-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker Note",
      "default": "Universal Integration"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Compatibility & Pipeline Matrix"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Standardized specifications verified across industry standard game engines and digital content creation tools."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Pipeline Compatibility"
    }
  ]
}
{% endschema %}
