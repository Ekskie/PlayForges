{% comment %}
  PlayForge Category Explorer Section
  Interactive 9-category grid for indie game developers to quickly filter asset disciplines.
{% endcomment %}

<div class="pf-section" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="pf-container">
    <div class="pf-section-header">
      <div class="pf-section-title-wrap">
        <span class="pf-section-kicker">{{ section.settings.kicker | default: 'Asset Disciplines' }}</span>
        <h2 class="pf-section-title">{{ section.settings.heading | default: 'Browse by Category' }}</h2>
        <p class="pf-section-subtitle">{{ section.settings.subheading | default: 'Discover game-ready 3D components organized by pipeline discipline and environment requirements.' }}</p>
      </div>

      {%- if section.settings.view_all_link != blank -%}
        <a href="{{ section.settings.view_all_link }}" class="button button--secondary">
          {{ section.settings.view_all_label | default: 'All Categories' }}
        </a>
      {%- endif -%}
    </div>

    <div class="pf-category-grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="pf-cat-card" {{ block.shopify_attributes }}>
          <div class="pf-cat-icon">
            {%- case block.settings.icon -%}
              {%- when 'cube' -%}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                </svg>
              {%- when 'shield' -%}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
              {%- when 'user' -%}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                  <circle cx="12" cy="7" r="4"/>
                </svg>
              {%- when 'truck' -%}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="1" y="3" width="15" height="13"/>
                  <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
                  <circle cx="5.5" cy="18.5" r="2.5"/>
                  <circle cx="18.5" cy="18.5" r="2.5"/>
                </svg>
              {%- when 'tree' -%}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polygon points="12 2 19 12 15 12 20 19 4 19 9 12 5 12 12 2"/>
                  <line x1="12" y1="19" x2="12" y2="23"/>
                </svg>
              {%- when 'building' -%}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="4" y="2" width="16" height="20" rx="2" ry="2"/>
                  <line x1="9" y1="22" x2="9" y2="22.01"/>
                  <line x1="15" y1="22" x2="15" y2="22.01"/>
                  <line x1="8" y1="6" x2="8" y2="6.01"/>
                  <line x1="16" y1="6" x2="16" y2="6.01"/>
                  <line x1="8" y1="11" x2="8" y2="11.01"/>
                  <line x1="16" y1="11" x2="16" y2="11.01"/>
                  <line x1="8" y1="16" x2="8" y2="16.01"/>
                  <line x1="16" y1="16" x2="16" y2="16.01"/>
                </svg>
              {%- when 'grid' -%}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="3" width="7" height="7"/>
                  <rect x="14" y="3" width="7" height="7"/>
                  <rect x="14" y="14" width="7" height="7"/>
                  <rect x="3" y="14" width="7" height="7"/>
                </svg>
              {%- when 'zap' -%}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                </svg>
              {%- else -%}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                </svg>
            {%- endcase -%}
          </div>

          <div>
            <h3 class="pf-cat-name">{{ block.settings.title }}</h3>
            <span class="pf-cat-count">{{ block.settings.count | default: '140+ Assets' }}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Category Explorer",
  "tag": "section",
  "class": "pf-category-explorer-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Section Kicker",
      "default": "Asset Disciplines"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Browse by Category"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover game-ready 3D components organized by pipeline discipline and environment requirements."
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View All Button Label",
      "default": "All Categories"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category Name",
          "default": "Environment"
        },
        {
          "type": "text",
          "id": "count",
          "label": "Asset Count",
          "default": "1,840 Assets"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "cube", "label": "Cube / Prop" },
            { "value": "shield", "label": "Shield / Weapon" },
            { "value": "user", "label": "Character" },
            { "value": "truck", "label": "Vehicle" },
            { "value": "tree", "label": "Nature / Foliage" },
            { "value": "building", "label": "Building / Architecture" },
            { "value": "grid", "label": "Modular Kits" },
            { "value": "zap", "label": "VFX" }
          ],
          "default": "cube"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Explorer",
      "blocks": [
        { "type": "category", "settings": { "title": "Environment", "count": "2,420 Assets", "icon": "building" } },
        { "type": "category", "settings": { "title": "Props", "count": "3,890 Assets", "icon": "cube" } },
        { "type": "category", "settings": { "title": "Weapons", "count": "840 Assets", "icon": "shield" } },
        { "type": "category", "settings": { "title": "Characters", "count": "610 Assets", "icon": "user" } },
        { "type": "category", "settings": { "title": "Vehicles", "count": "450 Assets", "icon": "truck" } },
        { "type": "category", "settings": { "title": "Nature", "count": "1,220 Assets", "icon": "tree" } },
        { "type": "category", "settings": { "title": "Buildings", "count": "780 Assets", "icon": "building" } },
        { "type": "category", "settings": { "title": "Modular Kits", "count": "930 Assets", "icon": "grid" } },
        { "type": "category", "settings": { "title": "VFX", "count": "390 Assets", "icon": "zap" } }
      ]
    }
  ]
}
{% endschema %}
