{% comment %}
  PlayForge Category Discovery Section
  Minimalist, compact, high-efficiency discipline directory with quick-filter pills and tactile tiles.
{% endcomment %}

<div class="pf-section pf-cat-section" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; border-top: 1px solid var(--pf-border-subtle);">
  <div class="pf-container">
    <div class="pf-section-header pf-cat-section-header">
      <div class="pf-section-title-wrap">
        <span class="pf-section-kicker">{{ section.settings.kicker | default: 'Asset Disciplines' }}</span>
        <h2 class="pf-section-title">{{ section.settings.heading | default: 'Explore by Category' }}</h2>
        <p class="pf-section-subtitle">{{ section.settings.subheading | default: 'Discover 3D game assets organized by pipeline discipline and technical requirements.' }}</p>
      </div>

      {%- if section.settings.view_all_link != blank -%}
        <a href="{{ section.settings.view_all_link }}" class="button button--secondary pf-cat-all-btn">
          {{ section.settings.view_all_label | default: 'All categories' }}
        </a>
      {%- endif -%}
    </div>

    <!-- Minimalist Compact Category Tiles (3x3 Grid) -->
    <div class="pf-cat-minimal-grid">
      {%- for block in section.blocks -%}
        <a
          href="{{ block.settings.link | default: routes.all_products_collection_url }}"
          class="pf-cat-tile"
          {{ block.shopify_attributes }}
        >
          <div class="pf-cat-tile__left">
            <div class="pf-cat-tile__badge" aria-hidden="true">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 100 }}"
                  alt="{{ block.settings.title | escape }}"
                  loading="lazy"
                  class="pf-cat-tile__thumb"
                  width="36"
                  height="36"
                >
              {%- else -%}
                {%- case block.settings.icon -%}
                  {%- when 'building' -%}
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3 21h18M5 21V7l8-4v18M13 5.5l6 3V21M9 10h1M9 14h1M9 18h1M16 12h1M16 16h1"/>
                    </svg>
                  {%- when 'grid' -%}
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="3" width="7" height="7"></rect>
                      <rect x="14" y="3" width="7" height="7"></rect>
                      <rect x="14" y="14" width="7" height="7"></rect>
                      <rect x="3" y="14" width="7" height="7"></rect>
                    </svg>
                  {%- when 'cube' -%}
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                      <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                      <line x1="12" y1="22.08" x2="12" y2="12"></line>
                    </svg>
                  {%- when 'user' -%}
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                      <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                  {%- when 'shield' -%}
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                  {%- when 'truck' -%}
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="1" y="3" width="15" height="13"></rect>
                      <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                      <circle cx="5.5" cy="18.5" r="2.5"></circle>
                      <circle cx="18.5" cy="18.5" r="2.5"></circle>
                    </svg>
                  {%- when 'tree' -%}
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="12 2 19 12 14 12 18 18 6 18 10 12 5 12 12 2"></polygon>
                      <line x1="12" y1="18" x2="12" y2="22"></line>
                    </svg>
                  {%- when 'zap' -%}
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                    </svg>
                  {%- else -%}
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                      <polyline points="2 17 12 22 22 17"></polyline>
                      <polyline points="2 12 12 17 22 12"></polyline>
                    </svg>
                {%- endcase -%}
              {%- endif -%}
            </div>

            <div class="pf-cat-tile__info">
              <span class="pf-cat-tile__name">{{ block.settings.title }}</span>
              <span class="pf-cat-tile__meta">{{ block.settings.count | default: 'Browse assets' }}</span>
            </div>
          </div>

          <div class="pf-cat-tile__arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Category Discovery",
  "tag": "section",
  "class": "pf-category-explorer-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker Note",
      "default": "Asset Disciplines"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore by Category"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover 3D game assets organized by pipeline discipline and technical requirements."
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View All Action Label",
      "default": "All categories"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 16,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 16,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category Name",
          "default": "Environment"
        },
        {
          "type": "text",
          "id": "count",
          "label": "Asset Count Label",
          "default": "Browse assets"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Category Icon",
          "options": [
            { "value": "building", "label": "Architecture / Building" },
            { "value": "cube", "label": "Props / Meshes" },
            { "value": "shield", "label": "Weapons / Equipment" },
            { "value": "user", "label": "Characters / Rigs" },
            { "value": "truck", "label": "Vehicles" },
            { "value": "tree", "label": "Nature / Foliage" },
            { "value": "grid", "label": "Modular Kits" },
            { "value": "zap", "label": "VFX / Shaders" }
          ],
          "default": "cube"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Artwork"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Collection Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Discovery"
    }
  ]
}
{% endschema %}
