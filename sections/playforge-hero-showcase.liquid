{% comment %}
  PlayForge Editorial Hero Showcase
  Clean editorial composition pairing a strong statement with a dominant 3D studio viewport.
  No fake credibility statistics or sci-fi decorations.
{% endcomment %}

<div class="pf-hero-section" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="pf-container">
    <div class="pf-hero-split">
      <!-- Left Content Column: Editorial Typography -->
      <div class="pf-hero-content">
        {%- if section.settings.kicker != blank -%}
          <div class="pf-hero-kicker">{{ section.settings.kicker }}</div>
        {%- endif -%}

        <h1 class="pf-hero-title">
          {{ section.settings.heading | default: 'Build your world. One asset at a time.' }}
        </h1>

        <p class="pf-hero-desc">
          {{ section.settings.subheading | default: 'Production-ready 3D components with clean quad topology, calibrated PBR, and native engine prefabs for Unreal Engine and Unity.' }}
        </p>

        <div class="pf-hero-actions">
          <a href="{{ section.settings.primary_cta_link | default: routes.all_products_collection_url }}" class="button button--primary">
            {{ section.settings.primary_cta_label | default: 'Browse assets' }}
          </a>

          {%- if section.settings.secondary_cta_label != blank -%}
            <a href="{{ section.settings.secondary_cta_link | default: routes.all_products_collection_url }}" class="button button--secondary">
              {{ section.settings.secondary_cta_label }}
            </a>
          {%- endif -%}
        </div>
      </div>

      <!-- Right 3D Studio Viewport: Dominant Asset Showcase -->
      <div class="pf-hero-viewport-wrap pf-viewer-container">
        {%- assign hero_model_url = section.settings.model_url -%}
        {%- if hero_model_url == blank or hero_model_url contains 'KhronosGroup' -%}
          {%- assign hero_model_url = 'pf-model-helmet.glb' | asset_url -%}
        {%- endif -%}
        {%- assign hero_poster_url = section.settings.poster_image | image_url: width: 1200 -%}

        {% render '3d-viewer',
          model_url: hero_model_url,
          poster_url: hero_poster_url,
          alt: 'PlayForge Studio 3D Asset',
          viewer_id: 'hero',
          aspect_ratio: '16 / 11',
          show_toolbar: false,
          show_badge: false,
          allow_fullscreen: false,
          shadow_intensity: '0.7',
          exposure: '1.05',
          is_hero: true
        %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Editorial Hero Showcase",
  "tag": "section",
  "class": "pf-hero-showcase-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker Note",
      "default": "Independent 3D Studio Catalog"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Build your world. One asset at a time."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Production-ready 3D components with clean quad topology, calibrated PBR, and native engine prefabs for Unreal Engine and Unity."
    },
    {
      "type": "text",
      "id": "primary_cta_label",
      "label": "Primary Action Label",
      "default": "Browse assets"
    },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Primary Action Link"
    },
    {
      "type": "text",
      "id": "secondary_cta_label",
      "label": "Secondary Action Label",
      "default": "Free assets"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Secondary Action Link"
    },
    {
      "type": "text",
      "id": "model_url",
      "label": "Hero 3D Model GLB URL",
      "info": "Optional custom GLB model URL"
    },
    {
      "type": "image_picker",
      "id": "poster_image",
      "label": "Fallback Poster Image"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Editorial Hero Showcase"
    }
  ]
}
{% endschema %}
