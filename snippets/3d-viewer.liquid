{% comment %}
  Renders a high-performance 3D asset viewer component using Google <model-viewer>
  with graceful fallback to product imagery.

  Accepts:
  - model_url: {String} GLB/GLTF model source URL
  - poster_url: {String} Image preview URL
  - alt: {String} Accessible alt text
  - auto_rotate: {Boolean} Enable subtle idle rotation (default: true)
  - camera_controls: {Boolean} Enable mouse & touch orbit (default: true)
  - viewer_id: {String} Unique DOM identifier
  - aspect_ratio: {String} CSS aspect ratio (default: '1 / 1')
  - show_toolbar: {Boolean} Show viewport inspection toolbar (default: false)
  - allow_fullscreen: {Boolean} Allow fullscreen mode (default: false)
  - show_badge: {Boolean} Display technical 3D badge (default: true)
  - badge_text: {String} Custom badge label (default: '3D VIEW')
  - shadow_intensity: {String} Shadow softness (default: '1')
  - exposure: {String} Light exposure level (default: '1')
  - is_hero: {Boolean} True if rendered in Hero showcase (default: false)

  Usage:
  {%- assign poster_url = product.featured_media | image_url: width: 1000 -%}
  {% render '3d-viewer',
    model_url: product.metafields.custom.model_3d.value,
    poster_url: poster_url,
    alt: product.title,
    viewer_id: product.id,
    show_toolbar: true
  %}
{% endcomment %}

{%- liquid
  assign uid = viewer_id | default: 'demo' | append: '-' | append: 'now' | date: '%N' | slice: 0, 6
  assign has_model = false
  if model_url != blank
    assign has_model = true
  endif
-%}

<div
  id="pf-viewer-container-{{ uid }}"
  class="pf-viewer-container{% if is_hero %} pf-viewer--hero{% endif %}"
  style="aspect-ratio: {{ aspect_ratio | default: '1 / 1' }};"
  data-viewer-id="{{ uid }}"
>
  {%- if has_model -%}
    <model-viewer
      id="pf-viewer-{{ uid }}"
      src="{{ model_url }}"
      {% if poster_url != blank %}poster="{{ poster_url }}"{% endif %}
      alt="{{ alt | default: 'PlayForge 3D Model Asset' | escape }}"
      loading="lazy"
      reveal="auto"
      {% if camera_controls != false %}camera-controls{% endif %}
      touch-action="pan-y"
      {% if auto_rotate != false %}auto-rotate auto-rotate-delay="800" rotation-per-second="18deg"{% endif %}
      shadow-intensity="{{ shadow_intensity | default: '1' }}"
      exposure="{{ exposure | default: '1.0' }}"
      interaction-prompt="none"
      camera-orbit="0deg 75deg 105%"
      min-camera-orbit="auto auto 20%"
      max-camera-orbit="auto auto 300%"
      bounds="tight"
    >
      {% comment %} Progress loader overlay {% endcomment %}
      <div class="pf-viewer-loader" slot="poster">
        <div class="pf-spinner"></div>
        <span class="pf-loader-text">Loading 3D Asset</span>
      </div>

      {%- if show_badge != false -%}
        <div class="pf-viewer-badge">
          <span>{{ badge_text | default: '3D Preview' }}</span>
        </div>
      {%- endif -%}

      {%- if show_toolbar -%}
        <div class="pf-viewer-toolbar" role="toolbar" aria-label="3D Viewport Controls">
          <button
            type="button"
            class="pf-toolbar-btn"
            data-pf-action="reset-camera"
            title="Reset Camera View"
            aria-label="Reset Camera View"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
              <path d="M3 3v5h5"/>
            </svg>
          </button>

          <button
            type="button"
            class="pf-toolbar-btn is-active"
            data-pf-action="toggle-rotate"
            title="Toggle Auto-Rotation"
            aria-label="Toggle Auto-Rotation"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 6v6l4 2"/>
            </svg>
          </button>

          <button
            type="button"
            class="pf-toolbar-btn"
            data-pf-action="toggle-grid"
            title="Toggle Viewport Grid"
            aria-label="Toggle Viewport Grid"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
              <line x1="3" y1="9" x2="21" y2="9"/>
              <line x1="3" y1="15" x2="21" y2="15"/>
              <line x1="9" y1="3" x2="9" y2="21"/>
              <line x1="15" y1="3" x2="15" y2="21"/>
            </svg>
          </button>

          {%- if allow_fullscreen != false -%}
            <button
              type="button"
              class="pf-toolbar-btn"
              data-pf-action="toggle-fullscreen"
              title="Toggle Fullscreen"
              aria-label="Toggle Fullscreen"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/>
              </svg>
            </button>
          {%- endif -%}
        </div>
      {%- endif -%}
    </model-viewer>
  {%- else -%}
    {% comment %} Graceful image fallback - Never shows broken viewer {% endcomment %}
    {%- if poster_url != blank -%}
      <img
        src="{{ poster_url }}"
        alt="{{ alt | default: 'PlayForge Game Asset' | escape }}"
        loading="lazy"
        class="pf-card-poster"
        width="600"
        height="600"
      >
    {%- else -%}
      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  {%- endif -%}
</div>
