<div class="pf-bundle-slots-group" data-bundle-discount-rate="25">
  <!-- Step 1: Environment & Prop Base -->
  <div class="pf-bundle-slot" data-slot="step_1">
    <div class="pf-slot-header">
      <span class="pf-slot-step">Step 1</span>
      <span class="pf-slot-name">Environment & Prop Base</span>
    </div>
    <div class="pf-slot-options">
      <button
        type="button"
        class="pf-slot-btn is-active"
        data-name="Tindahan ni Mama"
        data-price="39"
        data-poly="1021"
        data-model="{{ 'pf-upload-1791730951473-tindahan-ni-mama.glb' | asset_url }}"
        data-engine="UE5 / Unity / Godot"
        data-texture="4K PBR (Packed ORM)"
        data-license="Commercial Royalty-Free"
        data-handle="tindahan-ni-mama"
        data-variant-id="{{ all_products['tindahan-ni-mama'].variants.first.id | default: '' }}"
      >
        <span class="pf-slot-btn-title">Tindahan ni Mama</span>
        <span class="pf-slot-btn-price">₱39.00</span>
      </button>
      <button
        type="button"
